{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@k9-genius/db": ["packages/db/src"],
      "@k9-genius/api": ["packages/api/src"],
      "@k9-genius/ui": ["packages/ui/src"]
    }
  },
  "exclude": ["node_modules"]
}
