# K9 Genius LMS Environment Variables

# ============ DATABASE ============

# Prisma database connection string
DATABASE_URL="postgresql://user:password@localhost:5432/k9_genius_lms"

# ============ AUTHENTICATION ============

# Clerk authentication keys (for integrating with Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ============ WEBHOOK CONFIGURATION ============

# Base URL for webhook endpoint (used by integrations to call back)
K9_GENIUS_WEBHOOK_URL="https://lms.yourdomain.com"

# API key for external integrations (set via create-webhook-api-key script)
K9_GENIUS_API_KEY="sk_<generated_key>"

# Webhook logging (optional)
WEBHOOK_LOG_LEVEL="debug" # debug, info, warn, error

# ============ PAYMENT PROCESSOR WEBHOOKS ============

# Shopify webhook configuration
SHOPIFY_WEBHOOK_SECRET="whsec_..."
SHOPIFY_STORE_URL="your-store.myshopify.com"
SHOPIFY_API_KEY="sk_live_..."

# SamCart webhook configuration
SAMCART_WEBHOOK_SECRET="sc_webhook_secret..."
SAMCART_API_KEY="sc_api_key..."

# Stripe webhook configuration
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_API_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."

# ============ INTEGRATION PLATFORMS ============

# Zapier integration (if using Zapier webhooks)
ZAPIER_API_KEY="<your_zapier_api_key>"

# Make.com integration (if using Make webhooks)
MAKE_WEBHOOK_URL="https://hook.make.com/..."

# ============ MONITORING & LOGGING ============

# Log failed webhook events
LOG_FAILED_WEBHOOKS="true"

# Send alerts on webhook failures
SEND_WEBHOOK_ALERTS="true"
WEBHOOK_ALERT_EMAIL="admin@yourdomain.com"

# Enable detailed audit logging
AUDIT_LOG_ENABLED="true"

# ============ SECURITY ============

# Rate limiting (requests per minute per API key)
WEBHOOK_RATE_LIMIT_PER_MINUTE="100"

# IP whitelist for webhooks (comma-separated)
WEBHOOK_IP_WHITELIST=""

# Require HTTPS for webhooks
REQUIRE_WEBHOOK_HTTPS="true"

# ============ ENVIRONMENT ============

NODE_ENV="production" # production, development, test

# ============ APPLICATION ============

# Next.js port
PORT="3003"

# Vercel deployment
VERCEL_ENV="production"
VERCEL_URL="lms.yourdomain.com"
